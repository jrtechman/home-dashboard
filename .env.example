# Copy these into Vercel → your project → Settings → Environment Variables.
# Never commit real values to GitHub.

# Required: the passcode each screen asks for once.
HOUSEHOLD_PASSCODE=

# Optional: a long random string. If set, changing the passcode no longer signs screens out.
SESSION_SECRET=

# Set automatically when you add an Upstash Redis database from the Vercel Storage tab.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Set automatically when you add a Blob store from the Vercel Storage tab.
BLOB_READ_WRITE_TOKEN=

# Apple Calendar: Name|link pairs separated by semicolons. webcal:// links are fine.
# CALENDARS=Family|webcal://p00-caldav.icloud.com/published/2/...;Jason|webcal://...
CALENDARS=

# Save dashboard events into a real iCloud calendar (optional).
# Create an app-specific password at account.apple.com -> Sign-In and Security -> App-Specific Passwords.
# Never use your normal Apple password here.
ICLOUD_ID=
ICLOUD_APP_PASSWORD=
# Which iCloud calendar new events go to by default (the form lets you change it). Blank = the first one.
ICLOUD_CALENDAR=

# Your time zone, for showing calendar times.
HOME_TIMEZONE=America/New_York

# Photos from a shared iCloud album: Photos → the album → people icon → Public Website → copy link.
# Use a classic shared album link (icloud.com/sharedalbum/#…).
PHOTO_ALBUM=

# YNAB (read-only). Token: YNAB → Account Settings → Developer Settings → New Token.
YNAB_TOKEN=
# Leave blank to use the budget you opened last in YNAB.
YNAB_BUDGET_ID=
# Which categories the wall screen shows, comma-separated, spelled as in YNAB.
YNAB_CATEGORIES=Groceries, Dining Out
CURRENCY=USD

# Optional, paid per use (about 1 cent a draft): "Fill in from the photo" for dishes.
# Leave blank to skip; Paste a recipe and Import from a link are free and need no key.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5-5

# Verse of the day text (free key from api.esv.org). Without it Home shows the reference and a link.
ESV_API_KEY=

# Optional: admin passcode for the feature switches (Settings > Admin). If empty, the first admin
# sets one in the app. If set here it overrides the in-app one (recovery path).
ADMIN_PASSCODE=

# Optional: contact address sent to the phone makers' push services (default is a placeholder)
PUSH_SUBJECT=
